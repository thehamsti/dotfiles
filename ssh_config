# =============================================================================
# SSH Config Template - Copy to ~/.ssh/config
# =============================================================================

# Global defaults
Host *
    # Use macOS Keychain for SSH keys
    UseKeychain yes
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519

    # Keep connections alive
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Faster connections
    Compression yes

    # Keep OpenSSH's maintained algorithm defaults as macOS updates them.

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# =============================================================================
# Example: Custom server configurations
# =============================================================================

# Example: Personal server
# Host myserver
#     HostName 192.168.1.100
#     User myuser
#     IdentityFile ~/.ssh/id_ed25519
#     Port 22

# Example: Jump host / Bastion
# Host bastion
#     HostName bastion.example.com
#     User admin
#     IdentityFile ~/.ssh/bastion_key

# Example: Server behind bastion
# Host internal
#     HostName 10.0.0.50
#     User admin
#     ProxyJump bastion

# Example: AWS EC2 instance
# Host aws-web
#     HostName ec2-xx-xxx-xxx-xx.compute-1.amazonaws.com
#     User ec2-user
#     IdentityFile ~/.ssh/aws-key.pem

# Example: DigitalOcean droplet
# Host do-droplet
#     HostName xxx.xxx.xxx.xxx
#     User root
#     IdentityFile ~/.ssh/do_key
